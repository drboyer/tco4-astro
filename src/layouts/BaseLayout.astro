---
import '../styles/global.css';
import { siteName, siteDescription } from '../config/site';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = siteName, description = siteDescription, noindex = false } = Astro.props;
const isStaging = import.meta.env.SITE_ENV === 'staging';
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const pathname = Astro.url.pathname;
// Optional profile URLs; empty entries are hidden.
const socials = { github: 'https://github.com/drboyer', linkedin: 'https://www.linkedin.com/in/drboyer', instagram: 'https://www.instagram.com/wxdevin/' };
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content={description}/>{(noindex || isStaging) && <meta name="robots" content="noindex, follow"/>}{!noindex && <link rel="canonical" href={canonical}/> }<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/rss.xml"/><title>{pageTitle}</title></head>
<body>
<header class="site-header"><div class="container header-inner"><a class="logo" href="/">{siteName}</a><nav aria-label="Primary navigation" class="nav"><a class:list={[pathname==='/'&&'active']} href="/">Home</a><a class:list={[pathname.startsWith('/blog')&&'active']} href="/blog/">Blog</a><a class:list={[pathname.startsWith('/links')&&'active']} href="/links/">Links</a></nav></div></header>
<main><slot /></main>
<footer class="site-footer"><div class="container footer-inner"><div><strong>thecloudonline.net</strong><div><small>© {new Date().getFullYear()} Devin Boyer</small></div></div><nav class="footer-socials" aria-label="Social profiles">
  <a href={socials.github} aria-label="GitHub" title="GitHub" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.2-1.5 6.2-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6S17.7 1.2 15 3a13 13 0 0 0-6 0C6.3 1.2 5.2 1.5 5.2 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7A3.4 3.4 0 0 0 9 18.1V22"/></svg></a>
  {socials.linkedin && <a href={socials.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer"><span class="linkedin-mark" aria-hidden="true">in</span></a>}
  {socials.instagram && <a href={socials.instagram} aria-label="Instagram" title="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" stroke="none"/></svg></a>}
</nav></div></footer>
</body></html>
