---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page could not be found. Browse the blog or return to the homepage." noindex>
  <section class="container page-head">
    <h1>Page not found</h1>
    <p>The page may have moved, or the address may be incorrect.</p>
    <p><a href="/">Return to the homepage</a> or <a href="/blog/">browse the blog</a>.</p>
  </section>
</BaseLayout>
