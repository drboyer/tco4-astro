---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Blog"><header class="container page-head"><h1>From the Blog</h1><p>Notes, thoughts, and stories. The older posts are preserved here as an archive, with room for new writing whenever inspiration strikes.</p></header><section class="container archive-grid">{posts.map(post => <PostCard post={post} />)}</section></BaseLayout>
